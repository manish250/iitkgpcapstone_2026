# mock = sample data, no model needed | live = agent team's code (policy_agent.py)
POLICY_AGENT_MODE=mock
APP_TITLE=University Policy Copilot

# ---- live mode: what the agent notebook code reads ----
OPENAI_API_KEY=                 # group LLM key
EMBEDDINGS_KEY=                 # embedding API key
LLM_CA_CERT=vm05-ca.crt         # the UI types this into the notebook's certificate prompt
M4_CHECKPOINT_DB_PATH=./policy_agent_checkpoints.sqlite
# The notebook also expects data/vm02-ca.crt (embedding server) and looks for
# /content/vm02-ca.crt or /content/vm05-ca.crt. Endpoints and model are set inside the notebook code.

# ---- UI: related questions and rate limiting ----
FOLLOWUP_SUGGESTIONS=on
CHAT_RPM=20
TICKET_RPM=5
MAX_CONCURRENT_TURNS=4
TRUST_PROXY=false               # true only behind a proxy you control (reads X-Forwarded-For)

# Optional real ticketing (HTTPS only). If unset, support runs as DEMO ONLY.
UNIVERSITY_SUPPORT_API_URL=
UNIVERSITY_SUPPORT_API_TOKEN=
UNIVERSITY_SUPPORT_API_CA_BUNDLE=
